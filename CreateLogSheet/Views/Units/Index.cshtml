@model System.Data.DataTable

@{
    ViewData["Title"] = "داشبورد واحدهای عملیاتی";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="~/css/dashboard.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<style>
    .navbar {
        display: none;
    }
</style>

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- هدر داشبورد -->
    <div class="dashboard-header mb-4">
        <div class="row align-items-center g-3">
            <div class="col-md-6">
                <div class="d-flex align-items-center gap-3">
                    <div class="header-icon">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <div>
                        <h1 class="dashboard-title mb-0">داشبورد واحدها</h1>
                        <p class="dashboard-subtitle mb-0 mt-1">مدیریت و پایش لاگ‌شیت واحدهای عملیاتی</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex gap-2 justify-content-md-end">
                    <button class="btn-glass" onclick="window.open('@Url.Action("Index", "LogSheetReport")?unitId=all', '_blank')">
                        <i class="bi bi-file-bar-graph"></i>  گزارش ساز 
                    </button>
                    <button class="btn-primary-gradient" id="addUnitBtn">
                        <i class="bi bi-plus-circle"></i> واحد جدید
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- آمار سریع -->
    <div class="stats-row mb-4">
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary-soft">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">کل واحدها</span>
                        <h3 class="stat-value mb-0" id="totalUnitsCount">@(Model?.Rows.Count ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success-soft">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">فعال</span>
                        <h3 class="stat-value mb-0">@(Model?.Rows.Count ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning-soft">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">لاگ‌شیت امروز</span>
                        <h3 class="stat-value mb-0">12</h3>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info-soft">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">اپراتورها</span>
                        <h3 class="stat-value mb-0">8</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- نمایش به صورت کارت‌های گرافیکی -->
    <partial name="_unitPartials" model="@Model" />

</div>

<!-- ========== Modal افزودن واحد جدید ========== -->
<div class="modal fade" id="addUnitModal" tabindex="-1" aria-labelledby="addUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUnitModalLabel">
                    <i class="bi bi-building-add"></i> افزودن واحد عملیاتی جدید
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addUnitForm">
                    <div class="mb-3">
                        <label for="unitName" class="form-label">
                            <i class="bi bi-tag"></i> نام واحد <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="unitName" name="unitName"
                               placeholder="مثال: CDU, VDU, LPG, ..." required>
                        <div class="invalid-feedback">لطفاً نام واحد را وارد کنید</div>
                    </div>

                    <div class="mb-3">
                        <label for="areaName" class="form-label">
                            <i class="bi bi-map"></i> نام ناحیه <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="areaName" name="areaName"
                               placeholder="مثال: تقطیر، وی دی یو، گاز مایع، ..." required>
                        <div class="invalid-feedback">لطفاً نام ناحیه را وارد کنید</div>
                    </div>

                    <div class="mb-3">
                        <label for="parentId" class="form-label">
                            <i class="bi bi-diagram-3"></i> واحد والد (اختیاری)
                        </label>
                        <select class="form-select" id="parentId" name="parentId">
                            <option value="">بدون والد</option>
                            @if (Model != null && Model.Rows.Count > 0)
                            {
                                foreach (System.Data.DataRow row in Model.Rows)
                                {
                                    <option value="@row["UnitId"]">@row["UnitName"]</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle"></i>
                        با افزودن واحد جدید، می‌توانید برای آن شیت‌ها و گروه‌های لاگ‌شیت تعریف کنید.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> انصراف
                </button>
                <button type="button" class="btn btn-primary" id="confirmAddUnitBtn">
                    <i class="bi bi-check-circle"></i> افزودن واحد
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const cards = document.querySelectorAll('.unit-card');
        cards.forEach((card, index) => {
            card.style.animationDelay = `${index * 0.05}s`;
        });
    });

    // ========== مدیریت افزودن واحد جدید ==========
    $(document).ready(function () {
        // باز کردن Modal با کلیک روی دکمه
        $('#addUnitBtn').click(function () {
            resetForm();
            $('#addUnitModal').modal('show');
        });

        // ریست فرم
        function resetForm() {
            $('#unitName').val('');
            $('#areaName').val('');
            $('#parentId').val('');
            $('#unitName').removeClass('is-invalid');
            $('#areaName').removeClass('is-invalid');
        }

        // اعتبارسنجی فرم
        function validateForm() {
            let isValid = true;

            if (!$('#unitName').val().trim()) {
                $('#unitName').addClass('is-invalid');
                isValid = false;
            } else {
                $('#unitName').removeClass('is-invalid');
            }

            if (!$('#areaName').val().trim()) {
                $('#areaName').addClass('is-invalid');
                isValid = false;
            } else {
                $('#areaName').removeClass('is-invalid');
            }

            return isValid;
        }

        // ذخیره واحد جدید
        $('#confirmAddUnitBtn').click(function () {
            if (!validateForm()) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطا',
                    text: 'لطفاً تمام فیلدهای الزامی را پر کنید',
                    confirmButtonText: 'باشه',
                    confirmButtonColor: '#3b82f6'
                });
                return;
            }

            const unitData = {
                UnitName: $('#unitName').val().trim(),
                AreaName: $('#areaName').val().trim(),
                ParentID: $('#parentId').val() || null
            };

            // نشان دادن لودینگ
            Swal.fire({
                title: 'در حال ثبت...',
                text: 'لطفاً چند لحظه صبر کنید',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // ارسال به سرور
            $.ajax({
                url: '@Url.Action("Create", "Units")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(unitData),
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'موفق!',
                            text: 'واحد جدید با موفقیت اضافه شد',
                            confirmButtonText: 'باشه',
                            confirmButtonColor: '#10b981'
                        }).then(() => {
                            $('#addUnitModal').modal('hide');
                            // رفرش صفحه برای نمایش واحد جدید
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: response.message || 'مشکلی در ثبت واحد به وجود آمد',
                            confirmButtonText: 'باشه',
                            confirmButtonColor: '#ef4444'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا در ارتباط با سرور',
                        text: 'لطفاً دوباره تلاش کنید',
                        confirmButtonText: 'باشه',
                        confirmButtonColor: '#ef4444'
                    });
                }
            });
        });

        // پاک کردن خطاها هنگام تایپ
        $('#unitName, #areaName').on('input', function () {
            $(this).removeClass('is-invalid');
        });

        // بستن Modal با Escape
        $(document).keydown(function (e) {
            if (e.key === 'Escape') {
                $('#addUnitModal').modal('hide');
            }
        });
    });
</script>

