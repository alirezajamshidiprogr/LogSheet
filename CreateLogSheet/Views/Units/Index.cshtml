// تابع نمایش آخرین لاگ‌ها
function renderLastLogs() {
    const container = $('#lastLogsList');
    const count = sampleLastLogs.length;
    $('#lastLogsCount').text(count);
    
    if (count === 0) {
        container.html(`
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-4"></i>
                <p class="mb-0 mt-2">هیچ لاگی ثبت نشده است</p>
            </div>
        `);
        return;
    }
    
    let html = '';
    sampleLastLogs.forEach(log => {
        const shiftIcon = log.shift === 'صبح' ? 'bi-sunrise' : (log.shift === 'عصر' ? 'bi-sunset' : 'bi-moon-stars');
        html += `
            <div class="log-item">
                <div class="log-icon">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div class="log-content">
                    <div class="log-title">
                        <span class="unit-name">${escapeHtml(log.unitName)}</span> - ثبت لاگ شیت
                    </div>
                    <div class="log-detail">
                        <i class="bi bi-person"></i> کاربر: ${escapeHtml(log.userName)}
                        <span class="mx-1">|</span>
                        <i class="bi ${shiftIcon}"></i> شیفت: ${log.shift}
                    </div>
                    <div class="log-time">
                        <i class="bi bi-calendar3"></i> ${log.logDate}
                        <i class="bi bi-clock"></i> ${log.logTime}
                    </div>
                </div>
            </div>
        `;
    });
    
    container.html(html);
}

// تابع نمایش آخرین تغییرات مستر دیتا
function renderLastChanges() {
    const container = $('#lastChangesList');
    const count = sampleLastChanges.length;
    $('#lastChangesCount').text(count);
    
    if (count === 0) {
        container.html(`
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-4"></i>
                <p class="mb-0 mt-2">هیچ تغییری ثبت نشده است</p>
            </div>
        `);
        return;
    }
    
    let html = '';
    sampleLastChanges.forEach(change => {
        html += `
            <div class="change-item">
                <div class="change-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div class="change-content">
                    <div class="change-title">
                        <span class="unit-name">${escapeHtml(change.unitName)}</span> - 
                        <span class="sheet-name">${escapeHtml(change.sheetName)}</span> - 
                        <span class="group-name">${escapeHtml(change.groupName)}</span>
                    </div>
                    <div class="change-detail">
                         فیلد <strong>${escapeHtml(change.fieldName)}</strong> از 
                        <span class="old-value">${escapeHtml(change.oldValue)}</span> به 
                        <span class="new-value">${escapeHtml(change.newValue)}</span> تغییر یافت
                    </div>
                    <div class="change-time">
                        <i class="bi bi-calendar3"></i> ${change.changeDate}
                        <i class="bi bi-clock"></i> ${change.changeTime}
                        <span class="change-user">
                            <i class="bi bi-person"></i> ${escapeHtml(change.userName)}
                        </span>
                    </div>
                </div>
            </div>
        `;
    });
    
    container.html(html);
}

// تابع escape برای امنیت
function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

// بارگذاری داده‌ها
$(document).ready(function() {
    renderLastLogs();
    renderLastChanges();
});

