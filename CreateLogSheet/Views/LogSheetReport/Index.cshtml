@model List<Model>

<div class="container-fluid">
    <h3 class="mb-4">📊 گزارش لاگ شیت</h3>

    <div class="row g-3">

        <div class="col-md-4">
            <label>واحد عملیاتی (Operational Unit)</label>
            <select id="operationalUnitSelect" class="form-control" multiple="multiple">
                @foreach (var ou in Model.Select(x => x.OperationalUnit).Distinct())
                {
                    <option value="@ou">@ou</option>
                }
            </select>
        </div>


        <div class="col-md-4">
            <label>شیت</label>
            <select id="sheetNameSelect" class="form-control" multiple="multiple">
                @foreach (var s in Model.Select(x => x.SheetName).Distinct())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label>گروه</label>
            <select id="headerNameSelect" class="form-control" multiple="multiple">
                @foreach (var h in Model.Select(x => x.LogSheetHeaderName).Distinct())
                {
                    <option value="@h">@h</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label>شرح</label>
            <select id="descriptionSelect" class="form-control" multiple="multiple">
                @foreach (var d in Model.Select(x => x.Description).Distinct())
                {
                    <option value="@d">@d</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label>محل اندازه‌گیری (Measuring Position)</label>
            <select id="measuringPositionSelect" class="form-control" multiple="multiple">
                @foreach (var p in Model.Select(x => x.MeasuringPosition).Distinct())
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label>ویژگی (Characteristic)</label>
            <select id="characteristicSelect" class="form-control" multiple="multiple">
                @foreach (var c in Model.Select(x => x.Characteristic).Distinct())
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label>واحد اندازه‌گیری (Unit of Measure)</label>
            <select id="unitSelect" class="form-control" multiple="multiple">
                @foreach (var u in Model.Select(x => x.UnitOfMeasure).Distinct())
                {
                    <option value="@u">@u</option>
                }
            </select>
        </div>

        <!-- 🟢 فیلد جدید: واحد عملیاتی -->
        

    </div>

    <div class="table-responsive mt-4">
        <table class="table table-striped table-hover text-center align-middle" id="reportTable">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Sheet Name</th>
                    <th>Log Sheet Header Name</th>
                    <th>Description</th>
                    <th>Measuring Position</th>
                    <th>Characteristic</th>
                    <th>Unit of Measure</th>
                    <th>Operational Unit</th> <!-- ستون جدید -->
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div class="col-12">
            <button class="btn btn-light btn-add-unit">
                <i class="bi bi-eye"></i> ايجاد گزارش
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            const $sheet = $('#sheetNameSelect');
            const $header = $('#headerNameSelect');
            const $desc = $('#descriptionSelect');
            const $measuring = $('#measuringPositionSelect');
            const $characteristic = $('#characteristicSelect');
            const $unit = $('#unitSelect');
            const $operationalUnit = $('#operationalUnitSelect');
            const $tableBody = $('#reportTable tbody');

            // فعال‌سازی select2 برای همه
            $sheet.add($header).add($desc)
                .add($measuring).add($characteristic).add($unit).add($operationalUnit)
                .select2({
                    placeholder: "انتخاب کنید...",
                    width: '100%',
                    allowClear: true,
                    closeOnSelect: false,
                    language: {
                        noResults: () => "موردی یافت نشد"
                    }
                });

            // تابع بارگذاری گزارش
            async function loadReport() {
                const sheetNames = $sheet.val() || [];
                const headerNames = $header.val() || [];
                const descriptions = $desc.val() || [];
                const measuringPositions = $measuring.val() || [];
                const characteristics = $characteristic.val() || [];
                const units = $unit.val() || [];
                const operationalUnits = $operationalUnit.val() || [];

                try {
                    const response = await fetch(`/LogSheetReport/LogSheetReport`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            sheetNames: sheetNames,
                            headerNames: headerNames,
                            descriptions: descriptions,
                            measuringPositions: measuringPositions,
                            characteristics: characteristics,
                            unitOfMeasures: units,
                            operationalUnits: operationalUnits // 🟢 فیلتر جدید
                        })
                    });

                    const data = await response.json();
                    $tableBody.empty();

                    if (!data.length) {
                        $tableBody.append(`<tr><td colspan="9" class="text-danger">هیچ رکوردی یافت نشد.</td></tr>`);
                        return;
                    }

                    data.forEach((r, i) => {
                        $tableBody.append(`
                                    <tr>
                                        <td>${i + 1}</td>
                                        <td>${r.id}</td>
                                        <td>${r.sheetName || ''}</td>
                                        <td>${r.logSheetHeaderName || ''}</td>
                                        <td>${r.description || ''}</td>
                                        <td>${r.measuringPosition || ''}</td>
                                        <td>${r.characteristic || ''}</td>
                                        <td>${r.unitOfMeasure || ''}</td>
                                        <td>${r.operationalUnit || ''}</td>
                                    </tr>
                                `);
                    });
                } catch (err) {
                    console.error(err);
                    alert('خطا در بارگذاری گزارش');
                }
            }

            // هر بار فیلترها تغییر کنند، گزارش دوباره لود شود
            $sheet.add($header).add($desc)
                .add($measuring).add($characteristic).add($unit).add($operationalUnit)
                .on('change', loadReport);
        });
    </script>
}
