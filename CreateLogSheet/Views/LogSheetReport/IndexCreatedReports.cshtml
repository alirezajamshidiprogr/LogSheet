                        { id: 2, SheetName: "CDU1-FM-02(Page1)", HeaderName: "Vacuumtower,V-151", Description: "Pressure : top", MeasuringPosition: "PI-166", Characteristic: "Pressure", UnitOfMeasure: "bar" }
                    ]
                },
                {
                    id: 3,
                    reportName: "گزارش خصوصی کنترل فشار",
                    operationalUnit: "واحد تقطیر در خلا",
                    accessType: "private",
                    startDate: "1403/06/01",
                    endDate: "1403/06/15",
                    createdDate: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).toISOString(),
                    filtersCount: 2,
                    filters: {
                        sheetNames: ["CDU1-FM-O1"],
                        characteristics: ["Pressure"]
                    },
                    reportData: [
                        { id: 1, SheetName: "CDU1-FM-O1", HeaderName: "Flashdrum,V-101", Description: "Pressure", MeasuringPosition: "PR-140", Characteristic: "Pressure", UnitOfMeasure: "bar" },
                        { id: 2, SheetName: "CDU1-FM-O1", HeaderName: "Desalter,V-126", Description: "Pressure", MeasuringPosition: "PIC-125", Characteristic: "Pressure", UnitOfMeasure: "bar" }
                    ]
                },
                {
                    id: 4,
                    reportName: "آنالیز دمای خروجی کوره‌ها",
                    operationalUnit: "واحد کوره",
                    accessType: "public",
                    startDate: "1403/05/15",
                    endDate: "1403/06/15",
                    createdDate: new Date(Date.now() - 8 * 24 * 60 * 60 * 1000).toISOString(),
                    filtersCount: 4,
                    filters: {
                        characteristics: ["Temperature"],
                        descriptions: ["Outlet temp.", "Combine temp.", "Stack temp."]
                    },
                    reportData: [
                        { id: 1, SheetName: "CDU1-FM-02(Page1)", HeaderName: "Atmosphericheater,H-101", Description: "Outlet temp.", MeasuringPosition: "TI-049/056", Characteristic: "Temperature", UnitOfMeasure: "°C" },
                        { id: 2, SheetName: "CDU1-FM-02(Page1)", HeaderName: "Atmosphericheater,H-101", Description: "Combine temp.", MeasuringPosition: "TI-057", Characteristic: "Temperature", UnitOfMeasure: "°C" }
                    ]
                },
