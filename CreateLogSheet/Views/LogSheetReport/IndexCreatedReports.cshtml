            // رویدادهای فیلتر
            $('#searchInput, #accessTypeFilter, #unitFilter, #dateFilter').on('input change', function () {
                filterAndRender();
            });

            $('#refreshBtn').click(function () {
                loadReports();
            });

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/[&<>]/g, function (m) {
                    if (m === '&') return '&amp;';
                    if (m === '<') return '&lt;';
                    if (m === '>') return '&gt;';
                    return m;
                });
            }

            // بارگذاری اولیه
            loadReports();
        });
    </script>
}