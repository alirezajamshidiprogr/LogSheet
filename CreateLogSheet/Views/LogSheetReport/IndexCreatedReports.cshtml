@*<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">*@

<div class="container-fluid px-4 py-4">
    <!-- هدر صفحه -->
    <div class="reports-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="mb-1">
                    <i class="bi bi-archive"></i> گزارش‌های ذخیره شده
                </h2>
                <p class="text-muted mb-0">مدیریت و مشاهده گزارش‌های ایجاد شده</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary" id="refreshBtn">
                    <i class="bi bi-arrow-repeat"></i> بروزرسانی
                </button>
                <a href="@Url.Action("Index", "LogSheetReport")" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> گزارش جدید
                </a>
            </div>
        </div>
    </div>

    <!-- فیلترها -->
    <div class="filters-card mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">جستجو</label>
                <input type="text" id="searchInput" class="form-control" placeholder="جستجو در نام گزارش...">
            </div>
            <div class="col-md-3">
                <label class="form-label">نوع دسترسی</label>
                <select id="accessTypeFilter" class="form-select">
                    <option value="">همه</option>
                    <option value="public">عمومی</option>
                    <option value="private">خصوصی</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">واحد عملیاتی</label>
                <select id="unitFilter" class="form-select">
                    <option value="">همه</option>
                    @if (displayReports != null)
                    {
                        foreach (var unit in displayReports.Select(x => x.OperationalUnit).Distinct())
                        {
                            <option value="@unit">@unit</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">محدوده تاریخ</label>
                <select id="dateFilter" class="form-select">
                    <option value="">همه</option>
                    <option value="today">امروز</option>
                    <option value="thisWeek">این هفته</option>
                    <option value="thisMonth">این ماه</option>
                    <option value="thisYear">امسال</option>
                </select>
            </div>
        </div>
    </div>

    <!-- کارت‌های گزارش‌ها -->
    <div class="reports-grid" id="reportsGrid">
        @if (displayReports != null && displayReports.Any())
        {
            foreach (var report in displayReports.OrderByDescending(x => x.CreatedDate))
            {
                <div class="report-card" data-report-id="@report.Id" data-access-type="@report.AccessType" data-operational-unit="@report.OperationalUnit" data-created-date="@report.CreatedDate.ToString("yyyy-MM-dd")">
                    <div class="report-card-header">
                        <div class="report-icon">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                        </div>
                        <div class="report-actions">
                            @if (report.AccessType == "private")
                            {
                                <span class="badge-private">
                                    <i class="bi bi-lock"></i> خصوصی
                                </span>
                            }
                            else
                            {
                                <span class="badge-public">
                                    <i class="bi bi-globe2"></i> عمومی
                                </span>
                            }
                        </div>
                    </div>
                    <div class="report-card-body">
                        <h5 class="report-name">@report.ReportName</h5>
                        <div class="report-info">
                            <div class="info-item">
                                <i class="bi bi-building"></i>
                                <span>@report.OperationalUnit</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-calendar3"></i>
                                <span>@(Convert.ToDateTime(report.CreatedDate).ToString("yyyy/MM/dd"))</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-calendar-range"></i>
                                <span>@report.StartDate تا @report.EndDate</span>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-funnel"></i>
                                <span>@(report.FiltersCount) فیلتر</span>
                            </div>
                        </div>
                    </div>
                    <div class="report-card-footer">
                        <button class="btn-view-report" data-id="@report.Id">
                            <i class="bi bi-eye"></i> مشاهده گزارش
                        </button>
                        <button class="btn-delete-report" data-id="@report.Id" data-name="@report.ReportName">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-reports" id="emptyState">
                <i class="bi bi-inbox"></i>
                <h4>هیچ گزارشی یافت نشد</h4>
                <p>برای شروع، یک گزارش جدید ایجاد کنید.</p>
                <a href="@Url.Action("Index", "LogSheetReport")" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> ایجاد گزارش جدید
                </a>
            </div>
        }
    </div>
</div>

<!-- Modal مشاهده گزارش (نمایش دمو) -->
<!-- Modal مشاهده گزارش -->
<div class="modal fade" id="viewReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    <span id="modalReportTitle"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- اطلاعات گزارش -->
                <div class="report-info-section mb-4">
                    <div class="info-row">
                        <div class="info-label">
                            <i class="bi bi-building"></i> واحد عملیاتی:
                        </div>
                        <div class="info-value" id="modalOperationalUnit">-</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">
                            <i class="bi bi-lock"></i> نوع دسترسی:
                        </div>
                        <div class="info-value" id="modalAccessType">-</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">
                            <i class="bi bi-calendar3"></i> تاریخ ایجاد:
                        </div>
                        <div class="info-value" id="modalCreatedDate">-</div>
                    </div>
                </div>

                <!-- فیلترهای اعمال شده (خلاصه) -->
                <div class="filters-section mb-4">
                    <div class="filters-title">
                        <i class="bi bi-funnel"></i> فیلترهای اعمال شده:
                    </div>
                    <div id="modalFilters" class="filters-badges">
                        <!-- فیلترها اینجا نمایش داده می‌شوند -->
                    </div>
                </div>

                <!-- انتخاب بازه زمانی جدید -->
                <div class="date-range-section">
                    <div class="section-title mb-3">
                        <i class="bi bi-calendar-range"></i> انتخاب بازه زمانی برای نمایش گزارش
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">تاریخ شروع</label>
                            <input type="date" class="form-control" id="reportStartDate" placeholder="تاریخ شروع">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">تاریخ پایان</label>
                            <input type="date" class="form-control" id="reportEndDate" placeholder="تاریخ پایان">
                        </div>
                    </div>

                    <!-- دکمه‌های پیشنهادی بازه زمانی -->
                    <div class="quick-date-buttons mt-3">
                        <button type="button" class="quick-date-btn" data-days="7">۷ روز اخیر</button>
                        <button type="button" class="quick-date-btn" data-days="30">۳۰ روز اخیر</button>
                        <button type="button" class="quick-date-btn" data-days="90">۹۰ روز اخیر</button>
                        <button type="button" class="quick-date-btn" data-days="365">یک سال اخیر</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> انصراف
                </button>
                <button type="button" class="btn btn-primary" id="showReportBtn">
                    <i class="bi bi-eye"></i> نمایش گزارش
                </button>
            </div>
        </div>
    </div>
</div>

