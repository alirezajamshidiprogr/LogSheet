                    reportName: "گزارش عملکرد پمپ‌ها",
                    operationalUnit: "واحد پمپ",
                    accessType: "public",
                    startDate: "1403/04/01",
                    endDate: "1403/06/30",
                    createdDate: new Date(Date.now() - 20 * 24 * 60 * 60 * 1000).toISOString(),
                    filtersCount: 6,
                    filters: {
                        headerNames: ["Pumpsdailyrunningrecords"],
                        descriptions: ["Pump_101", "Pump_102", "Pump_103"]
                    },
                    reportData: [
                        { id: 1, SheetName: "CDU1-FM-O1", HeaderName: "Pumpsdailyrunningrecords", Description: "Pump_101", MeasuringPosition: "Pump_101", Characteristic: "character", UnitOfMeasure: "bar" },
                        { id: 2, SheetName: "CDU1-FM-O1", HeaderName: "Pumpsdailyrunningrecords", Description: "Pump_102", MeasuringPosition: "Pump_102", Characteristic: "character", UnitOfMeasure: "bar" },
                        { id: 3, SheetName: "CDU1-FM-O1", HeaderName: "Pumpsdailyrunningrecords", Description: "Pump_103", MeasuringPosition: "Pump_103", Characteristic: "character", UnitOfMeasure: "bar" }
                    ]
                },
                {
                    id: 6,
                    reportName: "گزارش خصوصی تنظیمات ایمنی",
                    operationalUnit: "واحد ایمنی",
                    accessType: "private",
                    startDate: "1403/06/01",
                    endDate: "1403/06/10",
                    createdDate: new Date(Date.now() - 1 * 24 * 60 * 60 * 1000).toISOString(),
                    filtersCount: 3,
                    filters: {
                        sheetNames: ["CDU1-FM-04"],
                        characteristics: ["Pressure", "Flow"]
                    },
                    reportData: [
                        { id: 1, SheetName: "CDU1-FM-04", HeaderName: "Splittertower,V-112", Description: "Top pressure", MeasuringPosition: "PRC-139", Characteristic: "Pressure", UnitOfMeasure: "bar" },
                        { id: 2, SheetName: "CDU1-FM-04", HeaderName: "Splittertower,V-112", Description: "Flow : feed", MeasuringPosition: "FR-136", Characteristic: "Flow", UnitOfMeasure: "CMH" }
                    ]
                }
            ];

            // گرفتن دیتای گزارش‌ها از سرور یا استفاده از نمونه
            function loadReports() {
                // ابتدا سعی می‌کنیم از سرور بگیریم
                $.ajax({
                    url: '/LogSheetReport/GetAllReports',
                    type: 'GET',
                    timeout: 3000,
                    success: function (response) {
                        if (response.success && response.data && response.data.length > 0) {
                            allReports = response.data;
                        } else {
                            // اگر از سرور دیتایی نیامد، از نمونه استفاده کن
                            allReports = sampleReportsData;
                        }
                        filterAndRender();
                    },
                    error: function () {
                        // در صورت خطا، از نمونه استفاده کن
                        console.log('خطا در بارگذاری از سرور، استفاده از داده‌های نمونه');
                        allReports = sampleReportsData;
                        filterAndRender();
                    }
                });
            }

            // فیلتر و رندر گزارش‌ها
            function filterAndRender() {
                const searchText = $('#searchInput').val().toLowerCase();
                const accessType = $('#accessTypeFilter').val();
                const operationalUnit = $('#unitFilter').val();
                const dateFilter = $('#dateFilter').val();

                let filtered = [...allReports];

                if (searchText) {
                    filtered = filtered.filter(r => r.reportName && r.reportName.toLowerCase().includes(searchText));
                }

                if (accessType) {
                    filtered = filtered.filter(r => r.accessType === accessType);
                }

                if (operationalUnit) {
                    filtered = filtered.filter(r => r.operationalUnit === operationalUnit);
                }

                if (dateFilter) {
                    const now = new Date();
                    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

                    filtered = filtered.filter(r => {
                        const created = new Date(r.createdDate);
                        if (dateFilter === 'today') {
                            return created >= today;
                        } else if (dateFilter === 'thisWeek') {
                            const weekAgo = new Date(today);
                            weekAgo.setDate(today.getDate() - 7);
                            return created >= weekAgo;
                        } else if (dateFilter === 'thisMonth') {
                            return created.getMonth() === now.getMonth() && created.getFullYear() === now.getFullYear();
                        } else if (dateFilter === 'thisYear') {
                            return created.getFullYear() === now.getFullYear();
                        }
                        return true;
                    });
                }

                renderReports(filtered);
            }

            // رندر کارت‌های گزارش
            function renderReports(reports) {
                const grid = $('#reportsGrid');

                if (!reports.length) {
                    grid.html(`
                                <div class="empty-reports" id="emptyState">
                                    <i class="bi bi-inbox"></i>
                                    <h4>هیچ گزارشی یافت نشد</h4>
                                    <p>با فیلترهای انتخاب شده، هیچ گزارشی پیدا نشد.</p>
                                </div>
                            `);
                    return;
                }

                let html = '';
                for (const report of reports) {
                    const createdDate = new Date(report.createdDate).toLocaleDateString('fa-IR');
                    html += `
                                <div class="report-card" data-report-id="${report.id}" data-access-type="${report.accessType}" data-operational-unit="${report.operationalUnit}">
                                    <div class="report-card-header">
                                        <div class="report-icon">
                                            <i class="bi bi-file-earmark-spreadsheet"></i>
                                        </div>
                                        <div class="report-actions">
                                            ${report.accessType === 'private'
                            ? '<span class="badge-private"><i class="bi bi-lock"></i> خصوصی</span>'
                            : '<span class="badge-public"><i class="bi bi-globe2"></i> عمومی</span>'}
                                        </div>
                                    </div>
                                    <div class="report-card-body">
                                        <h5 class="report-name">${escapeHtml(report.reportName)}</h5>
                                        <div class="report-info">
                                            <div class="info-item">
                                                <i class="bi bi-building"></i>
                                                <span>${escapeHtml(report.operationalUnit)}</span>
                                            </div>
                                            <div class="info-item">
                                                <i class="bi bi-calendar3"></i>
                                                <span>${createdDate}</span>
                                            </div>
                                            <div class="info-item">
                                                <i class="bi bi-calendar-range"></i>
                                                <span>${report.startDate || '-'} تا ${report.endDate || '-'}</span>
                                            </div>
                                            <div class="info-item">
                                                <i class="bi bi-funnel"></i>
                                                <span>${report.filtersCount || 0} فیلتر</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="report-card-footer">
                                        <button class="btn-view-report" data-id="${report.id}">
                                            <i class="bi bi-eye"></i> مشاهده گزارش
                                        </button>
                                        <button class="btn-delete-report" data-id="${report.id}" data-name="${escapeHtml(report.reportName)}">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </div>
                            `;
                }

                grid.html(html);
                attachCardEvents();
            }

            // اتصال رویدادهای کارت‌ها
            function attachCardEvents() {
                $('.btn-view-report').off('click').on('click', function () {
                    const reportId = $(this).data('id');
                    viewReport(reportId);
                });

                $('.btn-delete-report').off('click').on('click', function () {
                    const reportId = $(this).data('id');
                    const reportName = $(this).data('name');

                    Swal.fire({
                        title: 'حذف گزارش',
                        text: `آیا از حذف گزارش "${reportName}" اطمینان دارید؟`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'بله، حذف شود',
                        cancelButtonText: 'انصراف'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // حذف از لیست محلی
                            allReports = allReports.filter(r => r.id != reportId);
                            renderReports(allReports);
                            Swal.fire('موفق', 'گزارش با موفقیت حذف شد', 'success');
                        }
                    });
                });
            }

            // نمایش گزارش
            function viewReport(reportId) {
                const report = allReports.find(r => r.id == reportId);
                if (report) {
                    displayReportModal(report);
                } else {
                    Swal.fire('خطا', 'گزارش مورد نظر یافت نشد', 'error');
                }
            }

            // نمایش گزارش در Modal (نسخه جدید)
            function displayReportModal(report) {
                $('#modalReportTitle').text(report.reportName);
                $('#modalOperationalUnit').text(report.operationalUnit);

                const accessTypeText = report.accessType === 'private' ? 'خصوصی' : 'عمومی';
                const accessTypeIcon = report.accessType === 'private' ? '<i class="bi bi-lock"></i>' : '<i class="bi bi-globe2"></i>';
                $('#modalAccessType').html(`${accessTypeIcon} ${accessTypeText}`);

                const createdDate = new Date(report.createdDate).toLocaleDateString('fa-IR');
                $('#modalCreatedDate').text(createdDate);

                // نمایش فیلترها به صورت Badge
                const filters = report.filters || {};
                const filterItems = [];

                if (filters.sheetNames?.length) {
                    filters.sheetNames.forEach(f => filterItems.push({ label: 'شیت', value: f }));
                }
                if (filters.headerNames?.length) {
                    filters.headerNames.forEach(f => filterItems.push({ label: 'گروه', value: f }));
                }
                if (filters.descriptions?.length) {
                    filters.descriptions.forEach(f => filterItems.push({ label: 'شرح', value: f }));
                }
                if (filters.measuringPositions?.length) {
                    filters.measuringPositions.forEach(f => filterItems.push({ label: 'موقعیت', value: f }));
                }
                if (filters.characteristics?.length) {
                    filters.characteristics.forEach(f => filterItems.push({ label: 'ویژگی', value: f }));
                }
                if (filters.units?.length) {
                    filters.units.forEach(f => filterItems.push({ label: 'واحد', value: f }));
                }

                let filtersHtml = '';
                if (filterItems.length) {
                    filterItems.forEach(item => {
                        filtersHtml += `<span class="filter-badge"><span class="filter-label">${item.label}:</span> ${escapeHtml(item.value)}</span>`;
                    });
                } else {
                    filtersHtml = '<span class="text-muted">هیچ فیلتری اعمال نشده است</span>';
                }

                $('#modalFilters').html(filtersHtml);

                // تنظیم تاریخ‌های پیش‌فرض (بازه ذخیره شده گزارش)
                if (report.startDate) {
                    // تبدیل تاریخ شمسی به میلادی برای input date
                    const startDateObj = convertPersianToGregorian(report.startDate);
                    if (startDateObj) $('#reportStartDate').val(startDateObj.toISOString().split('T')[0]);
                } else {
                    // تاریخ پیش‌فرض: 30 روز قبل
                    const defaultStart = new Date();
                    defaultStart.setDate(defaultStart.getDate() - 30);
                    $('#reportStartDate').val(defaultStart.toISOString().split('T')[0]);
                }

                if (report.endDate) {
                    const endDateObj = convertPersianToGregorian(report.endDate);
                    if (endDateObj) $('#reportEndDate').val(endDateObj.toISOString().split('T')[0]);
                } else {
                    // تاریخ پیش‌فرض: امروز
                    const defaultEnd = new Date();
                    $('#reportEndDate').val(defaultEnd.toISOString().split('T')[0]);
                }
            }

            // تبدیل تاریخ شمسی به میلادی (ساده)
function convertPersianToGregorian(persianDate) {
    if (!persianDate) return null;
    // فرمت: 1403/05/01
    const parts = persianDate.split('/');
    if (parts.length !== 3) return null;
    try {
        // این یک تبدیل ساده است - برای تبدیل دقیق از کتابخانه استفاده کنید
        const year = parseInt(parts[0]);
        const month = parseInt(parts[1]);
        const day = parseInt(parts[2]);
        // تبدیل تقریبی - برای استفاده واقعی از کتابخانه مثل moment-jalaali استفاده کنید
        const gregorianDate = new Date(year - 621, month - 1, day);
        return gregorianDate;
    } catch(e) {
        return null;
    }
}

// دکمه‌های پیشنهادی بازه زمانی
$('.quick-date-btn').click(function() {
    const days = $(this).data('days');
    const endDate = new Date();
    const startDate = new Date();
    startDate.setDate(endDate.getDate() - days);
    
    $('#reportStartDate').val(startDate.toISOString().split('T')[0]);
    $('#reportEndDate').val(endDate.toISOString().split('T')[0]);
});

// نمایش گزارش در تب جدید
$('#showReportBtn').click(function() {
    const reportId = $(this).data('report-id') || currentReportId;
    const startDate = $('#reportStartDate').val();
    const endDate = $('#reportEndDate').val();
    
    if (!startDate || !endDate) {
        Swal.fire('خطا', 'لطفاً بازه زمانی را انتخاب کنید', 'error');
        return;
    }
    
    if (new Date(startDate) > new Date(endDate)) {
        Swal.fire('خطا', 'تاریخ شروع نباید از تاریخ پایان بزرگتر باشد', 'error');
        return;
    }
    
    // ساخت URL با پارامترها
    const url = `/LogSheetReport/ViewReport?id=${reportId}&startDate=${startDate}&endDate=${endDate}`;
    
    // باز کردن در تب جدید
    window.open(url, '_blank');
});

// ذخیره reportId جاری
let currentReportId = null;

// در تابع viewReport مقداردهی کن
function viewReport(reportId) {
    currentReportId = reportId;
    const report = allReports.find(r => r.id == reportId);
    if (report) {
        displayReportModal(report);
        $('#showReportBtn').data('report-id', reportId);
        $('#viewReportModal').modal('show');
    } else {
        Swal.fire('خطا', 'گزارش مورد نظر یافت نشد', 'error');
    }
}

            // خروجی Excel
            $('#exportReportBtn').click(function () {
