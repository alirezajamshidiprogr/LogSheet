@using System.Xml.Linq;
@model List<CreateLogSheet.Models.MeasurementPoint>

@functions {
    string ToSafeId(string input) => System.Text.RegularExpressions.Regex.Replace(input ?? "", @"[^a-zA-Z0-9]", "_");
}

@foreach (var group in Model.OrderBy(item => item.SheetHeaderOrder).GroupBy(r => r.LogSheetHeaderName))
{

    var collapseId = "collapse-" + ToSafeId(group.Key);
    <div class="card mb-3">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center"
         data-bs-toggle="collapse"
         href="#@collapseId"
         role="button"
         aria-expanded="true"
         aria-controls="@collapseId"
         style="cursor:pointer;">
            <span>@group.Key</span>
            <span><i class="bi bi-chevron-down"></i></span>
        </div>
        <div id="@collapseId" class="collapse show">
            <div class="card-body">
                @foreach (var row in group.OrderBy(item => item.SheetHeaderOrder))
                {
                    if (row.Characteristic == "Constant")
                    {
                        <div class="col-12 mb-2 constantClass">
                            @($"{row.Description} : {row.Characteristic} >> {row.FRConstantValue}")
                        </div>
                    }
                    else
                    {
                        <div class="row mb-2">
                            <div class="col-3">
                                <label>Description</label>
                                <input type="text" class="form-control" value="@row.Description" disabled />
                            </div>
                            <div class="col-1">
                                <label>MeasuringPosition</label>
                                <input type="text" class="form-control" value="@row.MeasuringPosition" disabled />
                            </div>
                            <div class="col-1-custom">
                                <label>Characteristic</label>
                                <input type="text" class="form-control" value="@row.Characteristic" disabled />
                            </div>
                            <div class="col-1-custom">
                                <label>UnitOfMeasure</label>
                                <input type="text" class="form-control" value="@row.UnitOfMeasure" disabled />
                            </div>

                            <div class="col-1-custom">
                                <label>Morning</label>
                                <div class="input-group">
                                    <input type="text" id="morningValue_@row.Id" data-shift="M" class="inputToSave form-control" value="@row.Morning_Value" data-hasSummery="true" data-hasChanged="false" data-measuringPointId="@row.Id" data-functionalLocation="@row.FunctionalLocation" data-upperRange="@row.UpperRangeLimit" data-lowerRange="@row.LowerRangeLimit" />
                                    @if (row.IsCalculated == true)
                                    {
                                        <span class="input-group-text p-0 text-center"
                                          data-formula="@row.FormulaResult"
                                          data-formulaRaw="@row.RawFormula"
                                          style="cursor:pointer; width:25px;"
                                          onclick="initializePopovers(this)">?</span>
                                    }
                                </div>
                            </div>
                            <div class="col-1-custom">
                                <label>Afternoon</label>
                                <div class="input-group">
                                    <input type="text" id="afternoonValue_@row.Id" data-shift="A" class="inputToSave form-control" value="@row.Afternoon_Value" data-hasChanged="false" data-measuringPointId="@row.Id" data-functionalLocation="@row.FunctionalLocation" data-upperRange="@row.UpperRangeLimit" data-lowerRange="@row.LowerRangeLimit" />
                                    @if (row.IsCalculated == true)
                                    {
                                        <span class="input-group-text p-0 text-center"
                                          data-formula="@row.FormulaResult"
                                          data-formulaRaw="@row.RawFormula"
                                          style="cursor:pointer; width:25px;"
                                          onclick="initializePopovers(this)">?</span>
                                    }
                                </div>
                            </div>
                            <div class="col-1-custom">
                                <label>Night</label>
                                <div class="input-group">
                                    <input type="text" id="eveningValue_@row.Id" data-shift="E" class="inputToSave form-control" value="@row.Evening_Value" data-hasChanged="false" data-measuringPointId="@row.Id" data-functionalLocation="@row.FunctionalLocation" data-upperRange="@row.UpperRangeLimit" data-lowerRange="@row.LowerRangeLimit" />
                                    @if (row.IsCalculated == true)
                                    {
                                        <span class="input-group-text p-0 text-center"
                              data-formula="@row.FormulaResult"
                              data-formulaRaw="@row.RawFormula"
                              style="cursor:pointer; width:25px;"
                              onclick="initializePopovers(this)">?</span>
                                    }
                                </div>
                            </div>

                            <div class="col-4">
                                <label for="exampleTextarea" class="form-label">توضیحات</label>
                                <textarea class="form-control" id="exampleTextarea" rows="1" placeholder="توضيحات را وارد کنید..."></textarea>
                            </div>
                        </div>
                    }
                }

                @* ⭐ اگر HeaderSummery مقدار داشت → Summery Footer اضافه کن *@
                @{
                    XDocument? headerHasSummary = group.First().HeaderSummery;
                }

                @if (headerHasSummary != null && headerHasSummary.Root != null)
                {
                    var summaryOps = headerHasSummary.Root.Elements("Operator").ToList();
                    var summeryId = "summery_" + ToSafeId(group.Key);

                    <div id="@summeryId" data-summery="true" class="row mt-3 p-2 border rounded bg-light summery-footer-box">

                        @foreach (var shiftName in new[] { "Morning", "Afternoon", "Night" })
                        {
                            if (summaryOps.Any(o =>
                            (o.Element("Shifts")?.Elements("Shift").Any(s => s.Value == shiftName)) == true))
                            {
                                var shiftCode = shiftName == "Morning" ? "M" :
                                shiftName == "Afternoon" ? "A" : "E";

                                <div class="col-4 summary-shift-box @shiftName">
                                    <span class="summary-group-title">@shiftName:</span>

                                    @foreach (var op in summaryOps)
                                    {
                                        // فقط اگر این اپراتور برای این شیفت تعریف شده بود
                                        if (op.Element("Shifts")?.Elements("Shift").Any(s => s.Value == shiftName) == true)
                                        {
                                            var opName = op.Attribute("name")?.Value;
                                            var opLabel = op.Attribute("label")?.Value;

                                            <span class="summary-item">
                                                @opLabel = <span class="sum-cell" data-op="@opName" data-shift="@shiftCode">0.00</span>
                                            </span>

                                            <span class="summary-sep">|</span>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                }






            </div>
        </div>
    </div>
}

