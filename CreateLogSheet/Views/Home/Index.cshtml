@using CreateLogSheet.Models
@model List<MeasurementPoint>



@{
    ViewData["Title"] = "Home Page";

    string ToSafeId(string input) => System.Text.RegularExpressions.Regex.Replace(input ?? "", @"[^a-zA-Z0-9]", "_");

    var sheetGroups = Model.GroupBy(m => m.SheetName).OrderBy(item => item.Max(a => a.SheetOrder)).Select(g => new SelectListItem
            {
                Text = g.Key,
                Value = g.Max(x => x.Id).ToString(),
            }).ToList();
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<link href="~/utilities/bootstrap-icons.css" rel="stylesheet" />
<link href="@Url.Content("~/css/site.css")" rel="stylesheet" />
<link href="~/utilities/sweetalert2.min.css" rel="stylesheet" />
<link href="~/css/logsheet.css" rel="stylesheet" />

<style>
    .navbar {
        display: none;
    }
</style>

<div class="container-fluid">
    <div id="formulaPopup" style="position:absolute; display:none; background:#333; color:#fff; padding:6px 10px; border-radius:6px; z-index:1000;"></div>

    <div class="row mb-3 header-row">
        <div class="col-4 d-flex justify-content-end gap-2">
            <button type="button" GetSheetData class="btn btn-success" id="saveBtn">ذخیره</button>
            <button type="button" class="btn btn-secondary" id="resetBtn">نوسازی</button>
        </div>
        <div class="col-3">
            <input type="text" id="logSheetDate" value="1404/08/30" class="form-control" placeholder="تاریخ را انتخاب کنید">
        </div>
        <div class="col-2">
            <h4>لاگ شيت واحد تقطير يك</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-2 sheet-list-col">
            <h4>Sheets</h4>
            <ul class="list-group">
                @foreach (var sheet in sheetGroups)
                {
                    <li id="sheet-@sheet.Value" class="list-group-item sheet-item" data-sheet="@sheet.Text">@sheet.Text</li>
                }
            </ul>
        </div>

        <div class="col-md-10">
            @foreach (var sheet in sheetGroups)
            {
                <div class="sheet-data" id="sheetRow-@sheet.Value" style="display:none;" data-active="false" data-sheet="@sheet.Text"></div>
            }
        </div>

        @* امضاهاي لاگ شيت *@
        <div class="col-md-12">
            <div class="signatures-section">
                <div class="signatures-title">
                    <i class="bi bi-pen"></i>
                    <span>امضاهای مسئولین شیفت</span>
                </div>
                <div class="signatures-grid">
                    <!-- شیفت صبح -->
                    <div class="signature-card shift-morning">
                        <div class="shift-header">
                            <i class="bi bi-sunrise"></i>
                            <span class="shift-name">شیفت صبح</span>
                            <div class="signature-date">
                                <i class="bi bi-calendar3"></i>
                                <span id="morningDate"></span>
                            </div>
                            <span class="shift-time">06:00 - 14:00</span>
                        </div>
                        <div class="signature-body">
                            <div class="signature-field">
                                <label>نام اپراتور مسئول</label>
                                <input type="text" class="form-control operator-name" id="morningOperator"
                                       placeholder="نام و نام خانوادگی" value="علیرضا جمشیدی" readonly>
                            </div>
                            <div class="signature-field">
                                <label>تایید نهایی</label>
                                <div class="signature-final">
                                    <div class="signature-image" id="morningSignatureImg">
                                        <img src="/images/signature.png" alt="امضا">
                                    </div>
                                    <div class="signature-status confirmed">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>تایید شده</span>
                                    </div>
                                </div>
                            </div>
                            <div class="signature-date">
                                <i class="bi bi-calendar3"></i>
                                <span id="morningDate"></span>
                            </div>
                        </div>
                    </div>

                    <!-- شیفت عصر -->
                    <div class="signature-card shift-afternoon">
                        <div class="shift-header">
                            <i class="bi bi-sunset"></i>
                            <span class="shift-name">
                                شیفت عصر</span>
                            <div class="signature-date">
                                <i class="bi bi-calendar3"></i>
                                <span id="afternoonDate"></span>
                            </div>
                            <span class="shift-time">14:00 - 22:00</span>
                        </div>
                        <div class="signature-body">
                            <div class="signature-field">
                                <label>نام اپراتور مسئول</label>
                                <input type="text" class="form-control operator-name" id="afternoonOperator"
                                       placeholder="نام و نام خانوادگی" value="محمد رضایی" readonly>
                            </div>
                            <div class="signature-field">
                                <label>تایید نهایی</label>
                                <div class="signature-final">
                                    <div class="signature-image" id="afternoonSignatureImg">
                                        <img src="/images/signature.png" alt="امضا">
                                    </div>
                                    <div class="signature-status confirmed">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>تایید شده</span>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <!-- شیفت شب -->
                    <div class="signature-card shift-night">
                        <div class="shift-header">
                            <i class="bi bi-moon-stars"></i>
                            <span class="shift-name">شیفت شب</span>
                            <span class="shift-time">22:00 - 06:00</span>
                            <div class="signature-date">
                                <i class="bi bi-calendar3"></i>
                                <span id="nightDate"></span>
                            </div>
                        </div>
                        <div class="signature-body">
                            <div class="signature-field">
                                <label>نام اپراتور مسئول</label>
                                <input type="text" class="form-control operator-name" id="nightOperator"
                                       placeholder="نام و نام خانوادگی" value="سعید کریمی" readonly>
                            </div>
                            <div class="signature-field">
                                <label>تایید نهایی</label>
                                <div class="signature-final">
                                    <div class="signature-image" id="nightSignatureImg">
                                        <img src="/images/signature.png" alt="امضا">
                                    </div>
                                    <div class="signature-status confirmed">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>تایید شده</span>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JS ها با ترتیب صحیح -->
<script src="~/utilities/sweetalert2@11.js"></script>
<script src="~/js/logsheet.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Tooltip روی input ها
            document.addEventListener('focus', function (ev) {
                const target = ev.target;
                if (target && target.tagName === 'INPUT') {
                    DisplayToolTipDate(ev);
                }
            }, true);

            document.addEventListener('change', function (ev) {
                const target = ev.target;
                if (target && target.tagName === 'INPUT') {
                    handleInputChanged(ev);
                }
            }, true);

            // بارگذاری خودکار داده ها برای همه sheet ها
            async function loadAllSheets() {
                const sheets = document.querySelectorAll('.sheet-data');
                const logSheetDate = document.getElementById('logSheetDate').value.trim();

                if (!isValidDate(logSheetDate)) {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'تاريخ را جهت ثبت مقادير لاگ شيبت مشخص كنيد.',
                        showConfirmButton: true,
                        confirmButtonText: 'باشه',
                        timer: 4000,
                        timerProgressBar: true
                    });
                    return;
                }

                for (let i = 0; i < sheets.length; i++) {
                    const div = sheets[i];
                    const sheetName = div.dataset.sheet;

                    try {
                        const response = await fetch(`/Home/GetSheetData?sheetName=${encodeURIComponent(sheetName)}&getDate=${encodeURIComponent(logSheetDate)}`);
                        if (!response.ok) throw new Error('خطا در پاسخ سرور');

                        const html = await response.text();
                        div.innerHTML = html;
                        div.dataset.active = "true";

                        // اولین sheet را visible کن، بقیه hidden
                        if (i === 0) {
                            div.style.display = 'block';
                            document.querySelectorAll('.sheet-item')[0].classList.add('active-sheet');
                        } else {
                            div.style.display = 'none';
                        }

                    } catch (err) {
                        console.error(`Error loading sheet ${sheetName}:`, err);
                    }
                }
            }

            loadAllSheets();

            // تنظیم تاریخ امضاها
            function setSignatureDates() {
                const today = new Date().toLocaleDateString('fa-IR');
                $('#morningDate').text(today);
                $('#afternoonDate').text(today);
                $('#nightDate').text(today);
            }

            // راه‌اندازی
            $(document).ready(function () {
                // تنظیم تاریخ امضاها
                setSignatureDates();
            });
        });
    </script>
}
